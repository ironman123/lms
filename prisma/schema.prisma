//prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  //engineType      = "library"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector"), pg_trgm]
}

model ExamCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String?
  image       String?
  color       String?  @default("#1D3557")
  createdAt   DateTime @default(now())
  slug        String   @unique
  exams       Exam[]
}

model Exam {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  description            String?
  url                    String?
  duration               Int
  categoryNumber         String?                 @unique
  totalMarks             Int
  color                  String                  @default("#0076c5")
  examCategoryId         String?
  createdAt              DateTime                @default(now())
  slug                   String                  @unique
  //categories     Category[]
  examCategory           ExamCategory?           @relation(fields: [examCategoryId], references: [id])
  tags                   ExamsTagsLink[]
  //questionPapers         QuestionPaper[]
  //examTopics     ExamTopic[]
  syllabusEntries        ExamSyllabusEntry[]
  examQuestionPaperLinks ExamQuestionPaperLink[]

  userExamStats UserExamStats[]

  bundles            ProductBundle[]
  events             ExamEvent[]
  notifications      Notification[]
  statsContributions SessionStatsContribution[]
  testSessions       TestSession[]
}

model Tag {
  id        String          @id @default(uuid())
  name      String          @unique
  icon      String?
  color     String?
  createdAt DateTime        @default(now())
  exams     ExamsTagsLink[]
}

model ExamsTagsLink {
  id        String   @id @default(uuid())
  examId    String
  tagId     String
  createdAt DateTime @default(now())
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([examId, tagId])
}

model Category {
  id                  String              @id @default(uuid())
  name                String              @unique
  //examId    String
  //exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdAt           DateTime            @default(now())
  topics              Topic[]
  examSyllabusEntries ExamSyllabusEntry[]
}

model Topic {
  id         String   @id @default(uuid())
  name       String
  categoryId String
  parentId   String?
  createdAt  DateTime @default(now())

  level     Int     @default(0) // 0 = Chapter, 1 = Topic, 2 = Sub-topic
  isLeaf    Boolean @default(true) // Quick check: Can I attach a question here?
  weightage String? // To store things like "12 marks" from your PDF
  slug      String?

  questions       Question[]
  category        Category            @relation(fields: [categoryId], references: [id])
  parent          Topic?              @relation("SubTopics", fields: [parentId], references: [id])
  children        Topic[]             @relation("SubTopics")
  topicMasteries  TopicMastery[]
  //examTopics     ExamTopic[]
  syllabusEntries ExamSyllabusEntry[]

  // This prevents two "Moment of Inertia" topics under the same parent
  @@unique([name, parentId])
  // This allows you to find top-level chapters by name + category
  @@unique([name, categoryId])
  // Index for faster tree traversal
  @@index([parentId])
}

// model ExamTopic {
//   id        String   @id @default(uuid())
//   examId    String
//   topicId   String
//   createdAt DateTime @default(now())
//   exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
//   topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

//   @@unique([examId, topicId])
// }

model ExamSyllabusEntry {
  id         String   @id @default(uuid())
  examId     String
  categoryId String
  topicPath  String // "Mechanics > Rotational Motion > Moment of Inertia"
  topicId    String? // soft FK to canonical Topic leaf node
  weightage  String?
  createdAt  DateTime @default(now())

  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id])
  topic     Topic?     @relation(fields: [topicId], references: [id])
  questions Question[]

  @@unique([examId, topicPath])
  @@index([examId, categoryId])
}

model ExamQuestionPaperLink {
  id        String   @id @default(uuid())
  examId    String
  paperId   String
  createdAt DateTime @default(now())

  exam  Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  paper QuestionPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([examId, paperId])
  @@index([examId])
  @@index([paperId])
}

model QuestionPaper {
  id              String            @id @default(uuid())
  title           String
  url             String?
  type            QuestionPaperType @default(PYQ)
  year            Int?
  contentRevision Int               @default(1)
  status          PaperStatus       @default(PUBLISHED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  isArchived      Boolean           @default(false)
  archivedAt      DateTime?
  archiveReason   String?
  questions       Question[]
  //exam      Exam?      @relation(fields: [examId], references: [id], onDelete: Cascade)
  //examId    String?

  testSessions           TestSession[]
  examQuestionPaperLinks ExamQuestionPaperLink[]
  moderationCases        ModerationCase[]
  imports                PaperImport[]

  //@@unique([examId, title])
}

model Question {
  id                String                 @id @default(uuid())
  content           String
  type              QuestionType
  difficulty        Difficulty             @default(MEDIUM)
  marks             Float                  @default(1.0)
  negativeMarks     Float                  @default(0.0)
  explanation       String?
  bloomsTaxonomy    Int                    @default(1)
  isVisual          Boolean                @default(false)
  discriminationIdx Float?
  avgTimeSeconds    Int                    @default(60)
  //embedding         Unsupported("vector")?
  topicId           String?
  topicPath         String?
  syllabusEntryId   String?
  paperId           String?
  position          Int
  sourceNumber      Int?
  importId          String?
  createdAt         DateTime               @default(now())
  isArchived        Boolean                @default(false)
  isCancelled       Boolean                @default(false)
  archivedAt        DateTime?
  archiveReason     String?
  contentRevision   Int                    @default(1)
  paper             QuestionPaper?         @relation(fields: [paperId], references: [id], onDelete: Cascade)
  topic             Topic?                 @relation(fields: [topicId], references: [id])
  syllabusEntry     ExamSyllabusEntry?     @relation(fields: [syllabusEntryId], references: [id], onDelete: SetNull)
  paperImport       PaperImport?           @relation(fields: [importId], references: [id], onDelete: SetNull)
  interactions      QuestionInteraction[]
  moderationCases   ModerationCase[]
  mistakeEntries    MistakeNotebookEntry[]
  analyticsDaily    QuestionAnalyticsDaily[]
  bookmarks         UserQuestionBookmark[]

  // MCQ + MSQ only
  options        Json? // OptionJSON[] | null for NUMERICAL/SUBJECTIVE
  correctOptions Int[] // [2] for MCQ, [0,2] for MSQ, [] for others

  // NUMERICAL only
  exactAnswer Float? // if answer is a single number
  answerMin   Float? // if answer is a range, e.g. 9.8 ± 0.1
  answerMax   Float? // answerMin: 9.7, answerMax: 9.9

  // SUBJECTIVE only
  modelAnswer String? // expected answer text for manual evaluation

  @@unique([paperId, position])
  @@index([paperId])
  @@index([paperId, isArchived])
  @@index([paperId, isArchived, isCancelled])
  @@index([topicId])
  @@index([syllabusEntryId])
  @@index([importId])
}

model PaperImport {
  id             String            @id @default(uuid())
  paperId        String
  createdById    String
  source         PaperImportSource
  status         PaperImportStatus @default(COMMITTED)
  idempotencyKey String
  sourceFileName String?
  sourceHash     String?
  questionCount  Int
  metadata       Json?
  createdAt      DateTime          @default(now())
  committedAt    DateTime?

  paper     QuestionPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  questions Question[]

  @@unique([paperId, idempotencyKey])
  @@index([paperId, createdAt])
  @@index([createdById, createdAt])
}

model QuestionInteraction {
  id                 String           @id @default(uuid())
  userId             String
  questionId         String
  sessionId          String
  visitCount         Int              @default(0)
  totalDwellTime     Int              @default(0)
  isCorrect          Boolean
  selectedAnswer     String?
  hesitationCount    Int              @default(0)
  isFlagged          Boolean          @default(false)
  wasHinted          Boolean          @default(false)
  confidenceLevel    Int?
  checkpointRevision BigInt           @default(0)
  grade              InteractionGrade @default(SKIPPED)
  questionPosition   Int?
  marksAwarded       Float            @default(0.0)
  penaltyApplied     Float            @default(0.0)
  questionSnapshot   Json?
  masteryDelta       Float?
  forgottenAt        DateTime?
  startedAt          DateTime         @default(now())
  createdAt          DateTime         @default(now())
  question           Question         @relation(fields: [questionId], references: [id])
  session            TestSession      @relation(fields: [sessionId], references: [id])
  user               User             @relation(fields: [userId], references: [id])

  @@unique([userId, questionId, sessionId])
  @@index([userId]) // "give me all interactions for a user"
  @@index([sessionId]) // "give me all interactions in a session"
  @@index([sessionId, questionPosition])
  @@index([userId, questionId]) // "has this user seen this question before?"
  @@index([questionId]) // "how many got this question right?" (analytics)
}

model User {
  id              String                @id @default(uuid())
  email           String                @unique
  supabaseId      String                @unique
  name            String?
  region          String?
  globalMastery   Float                 @default(0.0)
  totalStudyTime  Int                   @default(0)
  accuracyRate    Float                 @default(0.0)
  avatarUrl       String?
  //clerkId         String?               @unique
  college         String?
  createdAt       DateTime              @default(now())
  plan            PlanType?             @default(FREE)
  isPremium       Boolean               @default(false)
  lastActive      DateTime              @default(now())
  onboarded       Boolean               @default(false)
  questionsSolved Int                   @default(0)
  targetExams     String[]
  role            UserRole              @default(STUDENT)
  activityLogs    ActivityLog[]
  interactions    QuestionInteraction[]
  sessions        TestSession[]
  topicMasteries  TopicMastery[]

  userStats UserStats?
  examStats UserExamStats[]

  purchases               UserPurchase[]
  pushSubs                PushSubscription[]
  notifLogs               NotificationLog[]
  statsContributions      SessionStatsContribution[]
  contentReports          ContentReport[]
  moderationActions       ModerationAction[]           @relation("ModerationActionActor")
  assignedCases           ModerationCase[]             @relation("ModerationCaseAssignee")
  moderationConfigs       ModerationConfig[]           @relation("ModerationConfigUpdatedBy")
  configAudits            ModerationConfigAudit[]
  paperImports            PaperImport[]
  appFeedback             AppFeedback[]                @relation("AppFeedbackReporter")
  assignedFeedback        AppFeedback[]                @relation("AppFeedbackAssignee")
  acknowledgedFeedback    AppFeedback[]                @relation("AppFeedbackAcknowledgedBy")
  mistakeNotebook         MistakeNotebookEntry[]
  bookmarks               UserQuestionBookmark[]
  notificationPreferences UserNotificationPreference?
  interactionArchiveStats UserInteractionArchiveStats?
  retentionConfigsUpdated InteractionRetentionConfig[] @relation("InteractionRetentionConfigUpdatedBy")
}

model AppFeedback {
  id               String              @id @default(uuid())
  reporterId       String
  assignedToId     String?
  acknowledgedById String?
  category         AppFeedbackCategory
  status           AppFeedbackStatus   @default(NEW)
  priority         AppFeedbackPriority @default(NORMAL)
  title            String
  message          String
  pageUrl          String?
  userAgent        String?
  context          Json?
  adminResponse    String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?

  reporter       User  @relation("AppFeedbackReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignedTo     User? @relation("AppFeedbackAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  acknowledgedBy User? @relation("AppFeedbackAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([status, priority, updatedAt])
  @@index([reporterId, createdAt])
  @@index([assignedToId, status])
  @@index([acknowledgedById, acknowledgedAt])
}

model TestSession {
  id                   String                    @id @default(uuid())
  mode                 SessionMode               @default(PRACTICE)
  purpose              SessionPurpose            @default(STANDARD)
  status               SessionStatus             @default(ACTIVE)
  startTime            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  endTime              DateTime?
  lastCheckpointAt     DateTime?
  pausedAt             DateTime?
  abandonedAt          DateTime?
  abandonReason        String?
  expiresAt            DateTime?
  totalScore           Float?
  earnedMarks          Float?
  maximumMarks         Float?
  penaltyMarks         Float                     @default(0.0)
  pendingReviewCount   Int                       @default(0)
  questionSetSnapshot  Json?
  interactionArchive   Json?
  interactionsPurgedAt DateTime?
  totalQuestions       Int                       @default(0)
  correctCount         Int                       @default(0)
  accuracy             Float? // correctCount / totalQuestions
  timeTakenSecs        Int? // actual wall time
  pausedDurationSecs   Int                       @default(0)
  avgTimePerQ          Float?
  attemptedCount       Int                       @default(0) // not everyone answers all Qs
  completedAt          DateTime?
  userId               String
  paperId              String
  examId               String?
  examContextSource    SessionExamContextSource  @default(UNCLASSIFIED)
  activityLogs         ActivityLog[]
  interactions         QuestionInteraction[]
  paper                QuestionPaper             @relation(fields: [paperId], references: [id])
  user                 User                      @relation(fields: [userId], references: [id])
  exam                 Exam?                     @relation(fields: [examId], references: [id], onDelete: SetNull)
  statsContribution    SessionStatsContribution?
  contentReports       ContentReport[]
  mistakeEntries       MistakeNotebookEntry[]
  questionAnalyticsContribution QuestionAnalyticsContribution?

  @@index([userId, status, startTime])
  @@index([status, expiresAt])
  @@index([paperId, status])
  @@index([userId, completedAt])
  @@index([userId, examId, completedAt])
  @@index([userId, purpose, status, startTime])
  @@index([status, interactionsPurgedAt, completedAt])
}

model InteractionRetentionConfig {
  id                         String   @id @default("global")
  enabled                    Boolean  @default(false)
  retentionDays              Int      @default(180)
  maxDetailedSessionsPerUser Int      @default(50)
  batchSize                  Int      @default(25)
  updatedAt                  DateTime @updatedAt
  updatedById                String?
  updatedBy                  User?    @relation("InteractionRetentionConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model UserInteractionArchiveStats {
  userId            String   @id
  correctCount      Int      @default(0)
  incorrectCount    Int      @default(0)
  confidenceBuckets Json     @default("{}")
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InteractionRetentionRun {
  id                  String    @id @default(uuid())
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  dryRun              Boolean   @default(false)
  examinedSessions    Int       @default(0)
  archivedSessions    Int       @default(0)
  deletedInteractions Int       @default(0)
  skippedSessions     Int       @default(0)
  error               String?

  @@index([startedAt])
}

/// A short-lived, database-backed lease for scheduled maintenance. Unlike an
/// in-memory lock, it also works when Vercel starts a second function instance.
model MaintenanceLease {
  key         String   @id
  holderId    String
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt

  @@index([lockedUntil])
}

model QuestionAnalyticsContribution {
  id          String   @id @default(uuid())
  sessionId   String   @unique
  processedAt DateTime?
  createdAt   DateTime @default(now())
  lastError   String?

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([processedAt, createdAt])
}

model QuestionAnalyticsBackfillRun {
  id                String    @id @default(uuid())
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  dryRun            Boolean   @default(false)
  examinedSessions  Int       @default(0)
  projectedSessions Int       @default(0)
  skippedSessions   Int       @default(0)
  error             String?

  @@index([startedAt])
}

model QuestionAnalyticsDaily {
  id                   String   @id @default(uuid())
  questionId           String
  day                  String
  interactionCount     Int      @default(0)
  correctCount         Int      @default(0)
  incorrectCount       Int      @default(0)
  skippedCount         Int      @default(0)
  pendingCount         Int      @default(0)
  unavailableCount     Int      @default(0)
  totalDwellSeconds    Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  question             Question                         @relation(fields: [questionId], references: [id], onDelete: Restrict)
  optionSelections     QuestionOptionAnalyticsDaily[]
  confidenceSelections QuestionConfidenceAnalyticsDaily[]

  @@unique([questionId, day])
  @@index([day])
}

model QuestionOptionAnalyticsDaily {
  id              String   @id @default(uuid())
  dailyId         String
  selectedAnswer  String
  selectionCount  Int      @default(0)

  daily QuestionAnalyticsDaily @relation(fields: [dailyId], references: [id], onDelete: Cascade)

  @@unique([dailyId, selectedAnswer])
  @@index([dailyId])
}

model QuestionConfidenceAnalyticsDaily {
  id             String   @id @default(uuid())
  dailyId        String
  confidenceLevel Int
  correctCount   Int      @default(0)
  incorrectCount Int      @default(0)

  daily QuestionAnalyticsDaily @relation(fields: [dailyId], references: [id], onDelete: Cascade)

  @@unique([dailyId, confidenceLevel])
  @@index([dailyId])
}

model MistakeNotebookEntry {
  id                       String        @id @default(uuid())
  userId                   String
  questionId               String
  lastSessionId            String?
  status                   MistakeStatus @default(ACTIVE)
  wrongCount               Int           @default(1)
  correctAfterMistakeCount Int           @default(0)
  firstWrongAt             DateTime
  lastWrongAt              DateTime
  lastReviewedAt           DateTime
  nextReviewAt             DateTime?
  repairedAt               DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  lastSession TestSession? @relation(fields: [lastSessionId], references: [id], onDelete: SetNull)

  @@unique([userId, questionId])
  @@index([userId, status, nextReviewAt])
  @@index([userId, updatedAt])
  @@index([questionId])
  @@index([lastSessionId])
}

model ModerationConfig {
  id                      String   @id @default("global")
  questionReportThreshold Int      @default(3)
  paperReportThreshold    Int      @default(3)
  reportLimitPerHour      Int      @default(10)
  reportLimitPerDay       Int      @default(30)
  maxCommentLength        Int      @default(1000)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  updatedById             String?
  updatedBy               User?    @relation("ModerationConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model ModerationConfigAudit {
  id        String   @id @default(uuid())
  actorId   String
  before    Json
  after     Json
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model ModerationCase {
  id                  String               @id @default(uuid())
  targetType          ModerationTargetType
  questionId          String?
  paperId             String?
  questionRevision    Int?
  paperRevision       Int?
  snapshotHash        String?
  targetSnapshot      Json?
  activeKey           String?              @unique
  status              ModerationCaseStatus @default(OPEN)
  uniqueReporterCount Int                  @default(0)
  isEscalated         Boolean              @default(false)
  escalatedAt         DateTime?
  assignedToId        String?
  resolutionNote      String?
  resolvedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  question   Question?          @relation(fields: [questionId], references: [id], onDelete: Restrict)
  paper      QuestionPaper?     @relation(fields: [paperId], references: [id], onDelete: Restrict)
  assignedTo User?              @relation("ModerationCaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  reports    ContentReport[]
  actions    ModerationAction[]

  @@index([status, isEscalated, updatedAt])
  @@index([questionId, questionRevision])
  @@index([paperId, status])
  @@index([assignedToId, status])
}

model ContentReport {
  id          String         @id @default(uuid())
  caseId      String
  reporterId  String
  sessionId   String?
  category    ReportCategory
  source      ReportSource
  comment     String?
  context     Json?
  withdrawnAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  moderationCase ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reporter       User           @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  session        TestSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([caseId, reporterId])
  @@index([reporterId, createdAt])
  @@index([caseId, category])
  @@index([sessionId])
}

model ModerationAction {
  id        String               @id @default(uuid())
  caseId    String
  actorId   String?
  action    ModerationActionType
  note      String?
  metadata  Json?
  createdAt DateTime             @default(now())

  moderationCase ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor          User?          @relation("ModerationActionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
}

model SessionStatsContribution {
  id          String      @id @default(uuid())
  sessionId   String      @unique
  userId      String
  examId      String?
  payload     Json
  createdAt   DateTime    @default(now())
  processedAt DateTime?
  attempts    Int         @default(0)
  lastError   String?
  session     TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam        Exam?       @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@index([processedAt, createdAt])
  @@index([userId, processedAt])
  @@index([userId, examId, processedAt])
}

model ActivityLog {
  id        String      @id @default(uuid())
  sessionId String
  event     String
  metadata  Json?
  timestamp DateTime    @default(now())
  userId    String?
  session   TestSession @relation(fields: [sessionId], references: [id])
  user      User?       @relation(fields: [userId], references: [id])
}

model TopicMastery {
  id           String   @id @default(uuid())
  userId       String
  topicId      String
  currentScore Float    @default(0.0)
  lastTestedAt DateTime @default(now())
  history      Json?
  topic        Topic    @relation(fields: [topicId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@unique([userId, topicId])
}

model UserStats {
  userId          String   @id
  totalTests      Int      @default(0)
  totalQuestions  Int      @default(0)
  totalCorrect    Int      @default(0)
  totalStudySecs  Int      @default(0)
  scoreSum        Float    @default(0)
  currentStreak   Int      @default(0)
  lastActiveDate  String?
  typeAccuracy    Json     @default("{}")
  diffAccuracy    Json     @default("{}")
  subjectAccuracy Json     @default("{}")
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model UserExamStats {
  id             String   @id @default(uuid())
  userId         String
  examId         String
  testsAttempted Int      @default(0)
  scoreSum       Float    @default(0)
  bestScore      Float    @default(0)
  lastScore      Float?
  prevScore      Float?
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
  exam           Exam     @relation(fields: [examId], references: [id])

  @@unique([userId, examId])
  @@index([userId])
}

// ── Monetization ──────────────────────────────────────────────────────────────

model ProductBundle {
  id          String     @id @default(uuid())
  name        String // "KPSC Assistant Grade II — Mock Pack"
  description String?
  examId      String
  bundleType  BundleType @default(MOCK_PACK)
  paperIds    String[] // empty = all papers for this exam
  price       Int // in paise (9900 = ₹99)
  currency    String     @default("INR")
  validDays   Int? // null = lifetime, 30 = monthly
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  exam      Exam           @relation(fields: [examId], references: [id])
  purchases UserPurchase[]

  @@index([examId])
}

model UserPurchase {
  id                String         @id @default(uuid())
  userId            String
  bundleId          String
  razorpayOrderId   String         @unique
  razorpayPaymentId String?        @unique
  razorpaySignature String?
  status            PurchaseStatus @default(PENDING)
  amountPaid        Int // actual amount paid in paise
  expiresAt         DateTime? // null = lifetime
  createdAt         DateTime       @default(now())

  user   User          @relation(fields: [userId], references: [id])
  bundle ProductBundle @relation(fields: [bundleId], references: [id])

  @@index([userId])
  @@index([userId, bundleId])
}

// ── Notifications ─────────────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  title     String
  body      String
  url       String? // deep link on click
  examId    String? // null = broadcast to all
  type      NotificationType
  status    NotificationStatus @default(QUEUED)
  sentAt    DateTime?
  createdAt DateTime         @default(now())

  exam Exam?             @relation(fields: [examId], references: [id])
  logs NotificationLog[]
  deliveries NotificationDelivery[]

  @@index([status, createdAt])
}

/// One durable push attempt per device subscription.  This is intentionally
/// separate from the in-app notification; an unavailable push provider must
/// never make the notification itself disappear.
model NotificationDelivery {
  id             String                     @id @default(uuid())
  notificationId String
  subscriptionId String
  endpoint       String
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([notificationId, subscriptionId])
  @@index([subscriptionId])
  @@index([notificationId, status, createdAt])
  @@index([status, updatedAt])
}

model NotificationLog {
  id             String   @id @default(uuid())
  notificationId String
  userId         String
  delivered      Boolean  @default(false)
  createdAt      DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([notificationId])
  @@index([userId])
}

/// Student-controlled delivery choices. In-app messages are retained unless a
/// student opts out; push is always opt-in and additionally requires a device
/// subscription.
model UserNotificationPreference {
  userId                 String   @id
  inAppEnabled           Boolean  @default(true)
  pushEnabled            Boolean  @default(false)
  examUpdatesEnabled     Boolean  @default(true)
  practiceUpdatesEnabled Boolean  @default(true)
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A durable save-for-later marker, intentionally distinct from an in-session
/// flag. Flags belong to one attempt; bookmarks belong to the student.
model UserQuestionBookmark {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, updatedAt])
  @@index([questionId])
}

// ── Exam Calendar (admin-entered) ─────────────────────────────────────────────

model ExamEvent {
  id          String    @id @default(uuid())
  examId      String? // null = general KPSC news
  title       String
  description String?
  eventDate   DateTime
  type        EventType
  sourceUrl   String? // link to official notification
  isVerified  Boolean   @default(false) // admin-reviewed
  createdAt   DateTime  @default(now())

  exam Exam? @relation(fields: [examId], references: [id])

  @@index([examId])
  @@index([eventDate])
}

